{
  "name": "codex-cloud-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "description": "A self-hosted web console for operating Codex workers and repository automations on AWS EC2.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilsonWang01/codex-cloud-console.git"
  },
  "bugs": {
    "url": "https://github.com/WilsonWang01/codex-cloud-console/issues"
  },
  "homepage": "https://github.com/WilsonWang01/codex-cloud-console#readme",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:api\" \"vite --host 127.0.0.1\"",
    "api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "NODE_ENV=production node server/index.mjs",
    "codex:schema": "node scripts/update-codex-app-server-schema.mjs",
    "codex:schema:check": "node scripts/update-codex-app-server-schema.mjs --check",
    "codex:probe": "node scripts/probe-codex-runtime.mjs",
    "verify:normalizers": "node scripts/smoke-normalizers.mjs",
    "verify:runtime-probe": "node scripts/verify-runtime-probe.mjs",
    "verify:regressions": "node --test scripts/verify-release-info.mjs scripts/verify-proxy-transport.mjs && node scripts/verify-regressions.mjs",
    "verify:safety": "node --test scripts/verify-safety.mjs scripts/verify-body-parser.mjs scripts/verify-chat-reading.mjs scripts/verify-chat-history-window.mjs",
    "verify:approvals": "node --test scripts/verify-approvals.mjs",
    "verify:clients": "node --test scripts/verify-api-clients.mjs",
    "verify:external-client": "node --test scripts/verify-external-client-example.mjs",
    "verify:external-client:codex": "node scripts/verify-external-client-codex.mjs",
    "verify:mcp": "node --test scripts/verify-mcp.mjs",
    "verify:model-api": "node --test scripts/verify-model-api.mjs scripts/verify-api-discovery.mjs scripts/verify-structured-output.mjs scripts/verify-inline-inputs.mjs scripts/verify-external-input-body.mjs scripts/verify-pdf-inputs.mjs",
    "verify:model-api:codex": "node scripts/verify-model-api-codex.mjs",
    "verify:command-isolation:codex": "node scripts/verify-native-command-isolation.mjs",
    "verify:turn-events:codex": "node scripts/verify-turn-events-codex.mjs",
    "verify:delegation:codex": "node scripts/verify-native-delegation.mjs",
    "verify:turn-usage:ui": "node scripts/verify-turn-usage-ui.mjs",
    "verify:automation-events": "node --test scripts/verify-automation-events.mjs scripts/verify-external-callbacks.mjs scripts/verify-callback-inbox.mjs",
    "verify:usage": "node --test scripts/verify-run-usage.mjs scripts/verify-run-usage-ledger.mjs",
    "verify:admission": "node --test scripts/verify-run-admission.mjs scripts/verify-run-budget.mjs scripts/verify-external-task-store.mjs scripts/verify-external-results.mjs scripts/verify-external-result-api.mjs scripts/verify-automation-execution-profile.mjs",
    "verify:notifications": "node --test scripts/verify-notifications.mjs",
    "verify:personal-runtime": "node --test scripts/verify-personal-runtime.mjs",
    "verify:personal-files": "node --test scripts/verify-personal-files.mjs scripts/verify-safe-file-read.mjs",
    "verify:personal-file-bridge": "node --test scripts/verify-personal-file-bridge.mjs",
    "verify:personal-facts": "node --test scripts/verify-personal-facts.mjs scripts/verify-personal-memory.mjs scripts/verify-personal-fact-references.mjs",
    "verify:personal-facts:ui": "node scripts/verify-personal-facts-ui.mjs",
    "verify:personal-feedback": "node --test scripts/verify-personal-feedback.mjs scripts/verify-personal-feedback-api.mjs scripts/verify-feedback-visibility.mjs",
    "verify:personal-feedback:ui": "node scripts/verify-personal-feedback-ui.mjs",
    "verify:connections:ui": "node scripts/verify-connected-services-ui.mjs",
    "verify:personal-memory:codex": "node scripts/verify-personal-memory-codex.mjs",
    "verify:personal-memory:quality": "node scripts/verify-personal-memory-quality.mjs",
    "verify:mail-drafts:quality": "node scripts/verify-personal-mail-quality.mjs",
    "verify:personal-references:codex": "node scripts/verify-personal-memory-codex.mjs --references",
    "verify:personal-references:ui": "node scripts/verify-personal-fact-references-ui.mjs",
    "verify:personal-commitments": "node --test scripts/verify-personal-commitments.mjs scripts/verify-personal-commitments-api.mjs scripts/verify-personal-result-references.mjs scripts/verify-personal-result-references-api.mjs",
    "verify:personal-goal-progress-ui": "node scripts/verify-personal-goal-progress-ui.mjs",
    "verify:personal-results:ui": "node scripts/verify-personal-result-references-ui.mjs",
    "verify:personal-results:quality": "node scripts/verify-personal-result-references-ui.mjs && node scripts/verify-personal-followup-quality.mjs",
    "verify:personal-routines": "node --test scripts/verify-personal-routines.mjs",
    "verify:personal-schedule": "node --test scripts/verify-personal-schedule.mjs",
    "verify:personal-brief": "node --test scripts/verify-personal-brief.mjs scripts/verify-personal-calendar.mjs scripts/verify-personal-mail.mjs scripts/verify-personal-source-freshness.mjs scripts/verify-personal-mail-drafts.mjs scripts/verify-personal-calendar-actions.mjs scripts/verify-personal-calendar-tool.mjs",
    "verify:mail-drafts": "node --test scripts/verify-personal-mail-drafts.mjs",
    "verify:mail-drafts:codex": "node scripts/verify-personal-memory-codex.mjs --mail-drafts",
    "verify:personal-calendar-actions": "node --test scripts/verify-personal-calendar-actions.mjs",
    "verify:personal-calendar-actions:ui": "node scripts/verify-personal-calendar-actions-ui.mjs",
    "verify:personal-calendar:codex": "node scripts/verify-personal-memory-codex.mjs --calendar-proposals",
    "verify:external-action-review": "node --test scripts/verify-external-action-review.mjs",
    "verify:caddy-extension": "node --test scripts/verify-caddy-extension.mjs",
    "verify:github-workflow": "node --test scripts/verify-github-workflow.mjs",
    "verify:github-api": "node scripts/verify-github-api.mjs",
    "verify:github:ui": "node scripts/verify-github-ui.mjs",
    "verify:safety:ui": "node scripts/verify-safety-ui.mjs",
    "verify:chat-reading:ui": "node scripts/verify-chat-reading-ui.mjs",
    "verify:chat-history:ui": "node scripts/verify-chat-history-window-ui.mjs",
    "verify:runtime:ui": "node scripts/verify-runtime-ui.mjs",
    "verify:status:ui": "node scripts/verify-status-ui.mjs",
    "verify:recovery:ui": "node scripts/verify-module-recovery-ui.mjs",
    "verify:proxy:ui": "node scripts/verify-proxy-ui.mjs",
    "verify:personal:ui": "node scripts/verify-personal-usage-ui.mjs",
    "verify:mail:ui": "node scripts/verify-personal-mail-ui.mjs",
    "verify:calendar:ui": "node scripts/verify-personal-calendar-ui.mjs",
    "verify:runtime": "node scripts/verify-runtime-package.mjs",
    "verify:api": "node scripts/smoke-api.mjs",
    "verify:ui": "node scripts/smoke-ui.mjs",
    "verify:e2e": "node scripts/e2e-frontend.mjs",
    "verify:local": "npm run codex:schema:check && npm run verify:normalizers && npm run verify:runtime-probe && npm run build && npm run verify:regressions && npm run verify:safety && npm run verify:approvals && npm run verify:clients && npm run verify:external-client && npm run verify:mcp && npm run verify:model-api && npm run verify:automation-events && npm run verify:usage && npm run verify:admission && npm run verify:notifications && npm run verify:personal-runtime && npm run verify:personal-files && npm run verify:personal-file-bridge && npm run verify:personal-facts && npm run verify:personal-feedback && npm run verify:personal-commitments && npm run verify:personal-routines && npm run verify:personal-schedule && npm run verify:personal-brief && npm run verify:external-action-review && npm run verify:caddy-extension && npm run verify:github-workflow && npm run verify:github-api",
    "verify:cloud": "npm run verify:local && npm run verify:api && npm run verify:ui",
    "verify:cloud:full": "npm run verify:cloud && npm run verify:e2e",
    "cloud:console": "bash scripts/open-cloud-console.sh",
    "cloud:console:install": "bash scripts/install-cloud-console-agent.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@napi-rs/canvas": "1.0.10",
    "ajv": "8.20.0",
    "cron-parser": "5.10.1",
    "express": "^5.2.1",
    "html-to-text": "10.0.1",
    "luxon": "3.7.2",
    "pdfjs-dist": "6.4.299",
    "playwright": "^1.60.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@anthropic-ai/sdk": "0.131.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.556.0",
    "openai": "7.27.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
