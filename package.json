{
  "name": "codex-cloud-console",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted web console for operating Codex workers and repository automations on AWS EC2.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilsonWang01/codex-cloud-console.git"
  },
  "bugs": {
    "url": "https://github.com/WilsonWang01/codex-cloud-console/issues"
  },
  "homepage": "https://github.com/WilsonWang01/codex-cloud-console#readme",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:api\" \"vite --host 127.0.0.1\"",
    "api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "NODE_ENV=production node server/index.mjs",
    "codex:schema": "node scripts/update-codex-app-server-schema.mjs",
    "codex:schema:check": "node scripts/update-codex-app-server-schema.mjs --check",
    "verify:normalizers": "node scripts/smoke-normalizers.mjs",
    "verify:regressions": "node scripts/verify-regressions.mjs",
    "verify:safety": "node --test scripts/verify-safety.mjs",
    "verify:approvals": "node --test scripts/verify-approvals.mjs",
    "verify:clients": "node --test scripts/verify-api-clients.mjs",
    "verify:external-client": "node --test scripts/verify-external-client-example.mjs",
    "verify:automation-events": "node --test scripts/verify-automation-events.mjs",
    "verify:usage": "node --test scripts/verify-run-usage.mjs",
    "verify:admission": "node --test scripts/verify-run-admission.mjs scripts/verify-run-budget.mjs",
    "verify:notifications": "node --test scripts/verify-notifications.mjs",
    "verify:personal-runtime": "node --test scripts/verify-personal-runtime.mjs",
    "verify:personal-files": "node --test scripts/verify-personal-files.mjs",
    "verify:personal-file-bridge": "node --test scripts/verify-personal-file-bridge.mjs",
    "verify:personal-facts": "node --test scripts/verify-personal-facts.mjs",
    "verify:caddy-extension": "node --test scripts/verify-caddy-extension.mjs",
    "verify:safety:ui": "node scripts/verify-safety-ui.mjs",
    "verify:personal:ui": "node scripts/verify-personal-usage-ui.mjs",
    "verify:runtime": "node scripts/verify-runtime-package.mjs",
    "verify:api": "node scripts/smoke-api.mjs",
    "verify:ui": "node scripts/smoke-ui.mjs",
    "verify:e2e": "node scripts/e2e-frontend.mjs",
    "verify:local": "npm run codex:schema:check && npm run verify:normalizers && npm run build && npm run verify:regressions && npm run verify:safety && npm run verify:approvals && npm run verify:clients && npm run verify:external-client && npm run verify:automation-events && npm run verify:usage && npm run verify:admission && npm run verify:notifications && npm run verify:personal-runtime && npm run verify:personal-files && npm run verify:personal-file-bridge && npm run verify:personal-facts && npm run verify:caddy-extension",
    "verify:cloud": "npm run verify:local && npm run verify:api && npm run verify:ui",
    "verify:cloud:full": "npm run verify:cloud && npm run verify:e2e",
    "cloud:console": "bash scripts/open-cloud-console.sh",
    "cloud:console:install": "bash scripts/install-cloud-console-agent.sh"
  },
  "dependencies": {
    "express": "^5.2.1",
    "playwright": "^1.60.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
