{
  "openapi": "3.1.0",
  "info": {
    "title": "Codex Cloud 能力发现与异步任务",
    "version": "2026-10-23",
    "description": "覆盖能力发现、异步任务、受限内联 txt/md/PDF/图片材料、结构化结果及新任务的私有产物清单/下载。推理适配字段见 model-api-adapters.md；不宣称全 OpenAI/Anthropic 或 Files API 兼容。部署能力以 capabilities 为准。"
  },
  "servers": [{"url": "https://your-codex-cloud.example"}],
  "paths": {
    "/api/automations/{automationId}/v1/models": {
      "get": {
        "operationId": "listModels",
        "summary": "列出目录，不验证模型权限；不接受查询参数",
        "parameters": [{"$ref": "#/components/parameters/AutomationId"}],
        "security": [{"BearerToken": []}, {"AnthropicKey": []}, {"ClientToken": []}],
        "responses": {
          "200": {"description": "模型目录，created=0 表示创建日期未知", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Models"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/api/automations/{automationId}/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "协议、默认设置、运行时探测及保留边界；不接受查询参数",
        "parameters": [{"$ref": "#/components/parameters/AutomationId"}],
        "security": [{"BearerToken": []}, {"AnthropicKey": []}, {"ClientToken": []}],
        "responses": {
          "200": {"description": "能力快照，不执行模型", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Capabilities"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/api/automations/{automationId}/webhook": {
      "post": {
        "operationId": "submitRun",
        "summary": "创建任务，可能消耗模型额度；webhook 禁止 sessionId",
        "parameters": [{"$ref": "#/components/parameters/AutomationId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "security": [{"ClientToken": []}, {"BearerToken": []}, {"AnthropicKey": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Trigger"}}}},
        "responses": {
          "200": {"$ref": "#/components/responses/Run"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "413": {"$ref": "#/components/responses/InputTooLarge"},
          "415": {"$ref": "#/components/responses/UnsupportedInput"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "500": {"$ref": "#/components/responses/UnknownOutcome"}
        }
      }
    },
    "/api/automations/{automationId}/heartbeat": {
      "post": {
        "operationId": "continueRun",
        "summary": "续接本调用方最近会话，可能消耗模型额度",
        "parameters": [{"$ref": "#/components/parameters/AutomationId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "security": [{"ClientToken": []}, {"BearerToken": []}, {"AnthropicKey": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Trigger"}}}},
        "responses": {
          "200": {"$ref": "#/components/responses/Run"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"},
          "413": {"$ref": "#/components/responses/InputTooLarge"},
          "415": {"$ref": "#/components/responses/UnsupportedInput"},
          "429": {"$ref": "#/components/responses/RateLimited"},
          "500": {"$ref": "#/components/responses/UnknownOutcome"}
        }
      }
    },
    "/api/automations/{automationId}/runs/{runId}": {
      "get": {
        "operationId": "getRun",
        "parameters": [{"$ref": "#/components/parameters/AutomationId"}, {"$ref": "#/components/parameters/RunId"}, {"name": "after", "in": "query", "schema": {"type": "integer", "minimum": 0}}],
        "security": [{"ClientToken": []}, {"BearerToken": []}, {"AnthropicKey": []}],
        "responses": {
          "200": {"$ref": "#/components/responses/Run"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/RateLimited"}
        }
      }
    },
    "/api/automations/{automationId}/runs/{runId}/cancel": {
      "post": {
        "operationId": "cancelRun",
        "summary": "明确请求取消，不能撤回已经发生的外部动作",
        "parameters": [{"$ref": "#/components/parameters/AutomationId"}, {"$ref": "#/components/parameters/RunId"}],
        "security": [{"ClientToken": []}, {"BearerToken": []}, {"AnthropicKey": []}],
        "responses": {
          "200": {"$ref": "#/components/responses/Run"},
          "202": {"$ref": "#/components/responses/Run"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/automations/{automationId}/runs/{runId}/output": {
      "get": {
        "operationId": "getRunOutput", "summary": "读取本调用方已完成的新运行结果；不接受查询参数，不运行模型",
        "parameters": [{"$ref": "#/components/parameters/AutomationId"}, {"$ref": "#/components/parameters/RunId"}],
        "security": [{"ClientToken": []}, {"BearerToken": []}, {"AnthropicKey": []}],
        "responses": {
          "200": {"description": "完整结果与私有产物清单", "content": {"application/json": {"schema": {"type": "object", "required": ["ok", "result"], "properties": {"ok": {"const": true}, "result": {"$ref": "#/components/schemas/ResultManifest"}}}}}},
          "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"description": "运行尚未成功交付，查询原运行而非创建新事件"}, "410": {"$ref": "#/components/responses/ResultExpired"},
          "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    },
    "/api/automations/{automationId}/runs/{runId}/output/files/{fileId}": {
      "get": {
        "operationId": "downloadRunArtifact", "summary": "下载本调用方、本运行的私有副本；核对哈希，仅附件，不提供匿名 URL 或范围读取",
        "parameters": [{"$ref": "#/components/parameters/AutomationId"}, {"$ref": "#/components/parameters/RunId"}, {"name": "fileId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "security": [{"ClientToken": []}, {"BearerToken": []}, {"AnthropicKey": []}],
        "responses": {
          "200": {"description": "最多 8 MiB 的已校验文件副本，Content-Disposition:attachment", "headers": {"X-Content-SHA256": {"schema": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/Conflict"}, "410": {"$ref": "#/components/responses/ResultExpired"},
          "429": {"$ref": "#/components/responses/RateLimited"}, "503": {"$ref": "#/components/responses/Unavailable"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerToken": {"type": "http", "scheme": "bearer"},
      "AnthropicKey": {"type": "apiKey", "in": "header", "name": "x-api-key"},
      "ClientToken": {"type": "apiKey", "in": "header", "name": "x-codex-cloud-token"}
    },
    "parameters": {
      "AutomationId": {"name": "automationId", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
      "RunId": {"name": "runId", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "description": "业务持久键，重试必须同键同输入", "schema": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,160}$"}}
    },
    "responses": {
      "BadRequest": {"description": "未知字段或参数不支持"},
      "InputTooLarge": {"description": "JSON、文本/图片材料或执行载荷超过限制，未接收新任务；不截断输入"},
      "UnsupportedInput": {"description": "只接受未压缩的 application/json；附件类型、后缀/MIME 或来源不支持"},
      "Unauthorized": {"description": "令牌缺失、过期、撤销或自动化范围不符"},
      "NotFound": {"description": "不存在或不属于本调用方，不泄漏他人的目标"},
      "RateLimited": {"description": "限流，遵循 Retry-After 秒数", "headers": {"Retry-After": {"schema": {"type": "integer", "minimum": 1}}}},
      "Conflict": {"description": "同键不同输入或任务仍运行"},
      "Unavailable": {"description": "暂不可用；可按退避策略重试只读查询"},
      "ResultExpired": {"description": "交付副本到期，不会通过重新执行模型恢复；不要盲目更换事件键"},
      "UnknownOutcome": {"description": "提交结果可能未知，查询已知 run ID 或保持同键同输入重试"},
      "Run": {"description": "运行快照，HTTP 成功不等于业务完成；202 表示取消处理中", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunResponse"}}}}
    },
    "schemas": {
      "Models": {"type": "object", "required": ["object", "data", "codex_cloud"], "properties": {
        "object": {"const": "list"},
        "data": {"type": "array", "items": {"type": "object", "required": ["id", "object", "created", "owned_by", "codex_cloud"], "properties": {"id": {"type": "string"}, "object": {"const": "model"}, "created": {"const": 0}, "owned_by": {"const": "unknown"}, "codex_cloud": {"type": "object", "description": "display_name、reasoning_efforts、input_modalities、inference。inference 仅使用本调用方和自动化的保留记录，不代表当前账号权限；创建日期和所有者未由上游提供。"}}}},
        "codex_cloud": {"type": "object", "properties": {"catalog_status": {"enum": ["available", "stale"]}, "observed_at": {"type": ["string", "null"], "format": "date-time"}, "inference_verified": {"const": false}}}
      }},
      "Capabilities": {"type": "object", "required": ["object", "version", "automation_id", "defaults", "runtime", "catalog", "protocols", "features", "limits", "retention", "unsupported", "notes"], "properties": {
        "object": {"const": "codex_cloud.capabilities"}, "version": {"type": "string"}, "automation_id": {"type": "string"},
        "defaults": {"type": "object", "properties": {"model": {"type": "string"}, "reasoning": {"type": "string"}}},
        "runtime": {"type": "object", "properties": {"cli_version": {"type": ["string", "null"]}, "probed_at": {"type": "string", "format": "date-time"}, "protocol": {"const": "codex-app-server-v2"}}},
        "catalog": {"type": "object", "properties": {"status": {"enum": ["available", "stale", "unavailable"]}, "observed_at": {"type": ["string", "null"], "format": "date-time"}, "inference_verified": {"const": false}}},
        "protocols": {"type": "object"}, "features": {"type": "object", "properties": {"structured_output": {"type": "boolean", "description": "先查询部署版本；true 时支持 structured-output.md 的受限格式"}, "artifact_download": {"type": "boolean", "description": "true 时仅覆盖该版本接收的新任务，遵守 expiresAt"}, "result_manifest": {"type": "boolean"}, "callback": {"oneOf": [{"const": false}, {"type": "object", "required": ["supported", "configured"], "properties": {"supported": {"type": "boolean"}, "configured": {"type": "boolean"}, "events": {"type": "array", "items": {"const": "automation.run.terminal"}}, "signature": {"const": "hmac_sha256_v1"}, "max_attempts": {"const": 5}, "lifetime_ms": {"const": 86400000}, "duplicate_delivery_possible": {"const": true}, "polling_fallback": {"const": true}}}], "description": "仅操作者预登记目标，不能在提交正文指定 URL；见 callbacks.md"}, "request_output_token_limit": {"const": false}}},
        "limits": {"type": "object"}, "retention": {"type": "object"}, "unsupported": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "array", "items": {"type": "string"}}
      }},
      "Trigger": {"type": "object", "additionalProperties": false, "properties": {
        "runner": {"const": "app-server"}, "prompt": {"type": "string", "minLength": 1, "description": "UTF-8 不超过 65536 字节"}, "model": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{2,64}$"},
        "reasoning": {"enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]}, "search": {"type": "boolean"}, "worktree": {"const": true},
        "sessionId": {"type": "string", "minLength": 1, "maxLength": 160, "description": "仅 heartbeat 可用；webhook 拒绝"}, "completionContract": {"type": "object", "description": "详见 backend-integration.md，不能替代外部写入确认"},
        "outputSchema": {"type": ["object", "null"], "description": "受限 JSON Schema：16 KiB、8 层、128 节点，根为 object；省略或 null 不要求结构化；详见 structured-output.md"},
        "artifactPaths": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}, "description": "隔离工作树内待生成的相对路径；只收本轮新增/内容变化的 txt/md/json/csv/html/pdf/png/jpg/jpeg/webp 文件。拒绝隐藏目录、链接与旧内容；单份 8 MiB，清单和所有产物总计 20 MiB"},
        "attachments": {"type": "array", "maxItems": 8, "items": {"$ref": "#/components/schemas/InputAttachment"}, "description": "内联材料，不是服务器文件路径。txt/md 最多四份、单份 64 KiB、合计 128 KiB；PDF 最多两份、合计 4 MiB、每份 6 页、合计 8 页，转换页面与普通图片共享八张/8 MiB 图片上限；总正文 12 MiB。不支持远程 URL 或文件 ID"}
      }},
      "InputAttachment": {"type": "object", "additionalProperties": false, "required": ["name", "mimeType", "dataBase64"], "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 255, "description": "普通非隐藏文件名，UTF-8 最多 255 字节，不含路径或控制字符"},
        "mimeType": {"enum": ["text/plain", "text/markdown", "application/pdf", "image/png", "image/jpeg", "image/webp"], "description": "必须与 txt/md/pdf/png/jpg/jpeg/webp 后缀匹配"},
        "dataBase64": {"type": "string", "maxLength": 5592408, "description": "文件字节的标准 Base64，不能带 data URL 前缀或换行；解码大小另按类型限制"}
      }},
      "InputFileMetadata": {"type": "object", "additionalProperties": false, "required": ["index", "name", "mimeType", "bytes", "sha256"], "properties": {
        "index": {"type": "integer", "minimum": 1, "maximum": 8}, "name": {"type": "string"}, "mimeType": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 4194304}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }},
      "RunResponse": {"type": "object", "required": ["ok", "run"], "properties": {
        "ok": {"const": true}, "run": {"type": "object", "required": ["id", "automationId", "status"], "properties": {
          "id": {"type": "string"}, "automationId": {"type": "string"}, "status": {"enum": ["queued", "running", "canceling", "completed", "failed", "canceled", "cancelled", "interrupted", "needs_reconciliation"]},
          "startedAt": {"type": "string", "format": "date-time", "description": "任务接收时间"}, "executionStartedAt": {"type": ["string", "null"], "format": "date-time", "description": "实际开始执行时间；排队中可为空，用于 UTC 用量归属"},
          "summary": {"type": "string", "description": "可能截断，不等于完整结果或文件"}, "usage": {"type": "object"}, "error": {"type": ["string", "null"]}, "eventCursor": {"type": "integer", "minimum": 0},
          "inputFiles": {"type": "array", "maxItems": 8, "items": {"$ref": "#/components/schemas/InputFileMetadata"}, "description": "只含材料描述，不含内容/Base64；参与同事件键校验"},
          "inputProcessing": {"type": "object", "required": ["status"], "description": "PDF 转换状态及有界页数/文字和渲染字节/无文字层页号；不含内容，ready 不代表模型完成", "properties": {"status": {"enum": ["ready", "failed"]}, "parser": {"type": "string"}, "mode": {"const": "text_and_page_images"}, "files": {"type": "array", "maxItems": 2, "items": {"type": "object"}}, "error": {"type": "object", "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}},
          "structuredOutput": {"type": "object", "description": "验证成功为 validated/schemaSha256/data，失败为 invalid/error；data 是完整业务对象", "required": ["status"], "properties": {"status": {"enum": ["validated", "invalid"]}, "schemaSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "data": {"type": "object"}, "error": {"type": "object", "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}},
          "outputPath": {"type": "string", "description": "受限清单相对路径，仍需同一调用方认证"},
          "callbackDelivery": {"type": "object", "required": ["eventId", "status", "attempts"], "properties": {"eventId": {"type": "string", "format": "uuid"}, "status": {"enum": ["awaiting", "pending", "sending", "delivered", "failed"]}, "attempts": {"type": "integer", "minimum": 0, "maximum": 5}, "lastCode": {"type": ["string", "null"]}, "nextAttemptAt": {"type": ["string", "null"], "format": "date-time"}, "deliveredAt": {"type": ["string", "null"], "format": "date-time"}}, "description": "已登记任务的独立投递状态；GET 运行查询返回，不代表任务业务结果"},
          "delivery": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["pending", "ready", "failed", "expired"]}, "id": {"type": "string", "format": "uuid"}, "expiresAt": {"type": "string", "format": "date-time"}, "artifactCount": {"type": "integer", "minimum": 0, "maximum": 8}, "error": {"type": "object"}}}
        }},
        "eventCursor": {"type": "integer", "minimum": 0}, "eventGap": {"type": "boolean"}, "events": {"type": "array", "items": {"type": "object"}}
      }},
      "ResultManifest": {"type": "object", "required": ["version", "runId", "automationId", "status", "turnId", "capturedAt", "expiresAt", "text", "structuredOutput", "sources", "artifacts"], "properties": {
        "version": {"const": 1}, "runId": {"type": "string"}, "automationId": {"type": "string"}, "status": {"const": "completed"}, "turnId": {"type": "string"},
        "capturedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"}, "text": {"type": "string", "description": "原回合全文，UTF-8 最多 4 MiB，不使用截断摘要"},
        "structuredOutput": {"type": ["object", "null"]}, "sources": {"type": "array", "maxItems": 100, "items": {"type": "object", "required": ["url", "itemId", "kind"], "properties": {"url": {"type": "string", "format": "uri"}, "itemId": {"type": "string"}, "kind": {"enum": ["openPage", "findInPage"]}}}},
        "artifacts": {"type": "array", "maxItems": 8, "items": {"$ref": "#/components/schemas/Artifact"}}
      }},
      "Artifact": {"type": "object", "required": ["id", "name", "mimeType", "size", "sha256", "provenance", "downloadPath"], "properties": {
        "id": {"type": "string", "format": "uuid"}, "name": {"type": "string"}, "mimeType": {"type": "string"}, "size": {"type": "integer", "minimum": 0, "maximum": 8388608}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "provenance": {"enum": ["requested-path-changed-during-run", "native-image-item"]}, "nativeItemId": {"type": "string"}, "revisedPrompt": {"type": "string"}, "downloadPath": {"type": "string", "description": "同源受限相对路径，不能作为公开链接"}
      }}
    }
  }
}
