CODEX_CLOUD_WEBHOOK_TOKEN=replace-me-with-at-least-16-random-characters
CODEX_CLOUD_PUBLIC_ORIGIN=https://console.example.com
CODEX_CLOUD_HTTPS_HOST=console.example.com
# A turn now expires after 15 minutes without activity, while a one-hour hard cap
# still prevents a continuously noisy task from running forever.
CODEX_TURN_IDLE_TIMEOUT_MS=900000
CODEX_TURN_MAX_RUNTIME_MS=3600000
# On restart, continue only recently active interrupted app-server runs in their
# existing session. One bounded attempt avoids repeated side effects or loops.
CODEX_AUTOMATION_RECOVERY_ENABLED=1
CODEX_AUTOMATION_RECOVERY_MAX_AGE_MS=1800000
CODEX_AUTOMATION_RECOVERY_MAX_ATTEMPTS=1
CODEX_AUTOMATION_RECOVERY_STARTUP_DELAY_MS=1000
# Optional deployment-specific repository and automation arrays. Encode the JSON
# with base64 so systemd EnvironmentFile parsing cannot corrupt quotes or spaces.
# Relative repository paths resolve beneath CODEX_WORKSPACE_ROOT.
# CODEX_CLOUD_REPOS_CONFIG_B64=
# CODEX_CLOUD_AUTOMATIONS_CONFIG_B64=
AWS_REGION=ap-northeast-1
# Optional display-only metadata. Do not commit real values.
CODEX_PUBLIC_IP=203.0.113.10
CODEX_PRIVATE_IP=10.0.1.10
CODEX_INSTANCE_TYPE=t4g.small
# Optional external-site bridge.
BENXING_SITE_ORIGIN=https://app.example.com
BENXING_SITES_BYPASS_BEARER_TOKEN=replace-me-with-a-server-only-token
